---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  {
    name: 'Last Train Home',
    status: 'Coming soon to iPhone',
    description: 'Lay track across a miniature countryside and guide two toy mail trains home through 15 handcrafted railway puzzles.',
    image: '/images/last-train-home/featured.webp',
    alt: 'Three Last Train Home screens: laying track in Level 1, a completed two-train delivery and the Level 5 junction puzzle',
    href: '/last-train-home/',
    linkLabel: 'Discover Last Train Home',
  },
  {
    name: 'Ripple Links',
    status: 'On the App Store',
    description: 'Wake a sleeping pond, one ripple at a time. Forty-five hand-made ponds, each solved by reasoning, not luck. No timers, no lives.',
    image: '/images/games/ripple-links/showcase.webp',
    alt: 'Three Ripple Links screens: the Starlit Shallows pond map, a gate on Pond 16 about to open and the pond in bloom on Pond 40',
    href: 'https://apps.apple.com/gb/app/ripple-links/id6832125732',
    linkLabel: 'Get Ripple Links on the App Store',
  },
];
const playable = [
  { name: 'Daily Game Lab', status: 'Family beta', description: 'Six daily puzzles in one lab: three word games and three logic games, with a fresh puzzle every day.', image: '/images/games/daily-game-lab/showcase.webp', alt: 'Three Daily Game Lab screens: the Word Lab games, the lab home and the Game Lab logic puzzles', href: '/playtests/join/', linkLabel: 'Ask to join the beta', internal: true },
  { name: 'Orbit Slingshot', status: 'Coming soon to iPhone', description: 'Slingshot a little ship around neon planets and into the portal. Fifteen gravity puzzles, three stars each.', image: '/images/games/orbit-slingshot/showcase.webp', alt: 'Three Orbit Slingshot levels: Gravity Triangle, a docked trail on First Bend and Passing Lantern', href: '/orbit-slingshot/', linkLabel: 'Discover Orbit Slingshot', internal: true },
  { name: 'Night Parcel Office', status: 'Play now', description: 'Sort suspicious late-night parcels by the regulations.', image: '/images/games/night-parcel-office/showcase.webp', alt: 'Night Parcel Office final desk: shift regulations, a parcel label and the inspection tools', href: 'https://night-parcel-office.pages.dev/' },
];
---

<BaseLayout title="Games | Pluto Night Labs" description="Original games and experiments from Pluto Night Labs, including Last Train Home, Ripple Links, playable prototypes and work in progress.">
  <section class="games-hero shell">
    <div>
      <p class="eyebrow">Pluto Night Labs / Games</p>
      <h1>Strange ideas.<br /><em>Ready to play.</em></h1>
      <p>Original games from the studio, from playable browser prototypes to experiments still taking shape.</p>
      <a class="button button-primary" href="#featured-games">Explore the games <span aria-hidden="true">↓</span></a>
    </div>
    <div class="graham-art"><img src="/team/graham.png" alt="Graham, the Pluto Night Labs mascot" width="343" height="282" decoding="async" /></div>
  </section>

  <section class="game-section shell" id="featured-games" aria-labelledby="featured-title">
    <div class="section-heading"><p class="eyebrow">01 / Featured Games</p><h2 id="featured-title">Start somewhere unusual.</h2></div>
    <div class="featured-grid">
      {featured.map((game) => (
        <article class="featured-card">
          <div class="game-art"><img src={game.image} alt={game.alt} width="1600" height="1000" loading="lazy" decoding="async" /></div>
          <div class="game-copy"><span class="status">{game.status}</span><h3>{game.name}</h3><p>{game.description}</p><a href={game.href}>{game.linkLabel} <span aria-hidden="true">→</span></a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="game-section shell" aria-labelledby="playable-title">
    <div class="section-heading"><p class="eyebrow">02 / Playable Games</p><h2 id="playable-title">More worlds to try.</h2></div>
    <div class="playable-grid">
      {playable.map((game) => (
        <article class="playable-card">
          <img src={game.image} alt={game.alt} width="1600" height="1000" loading="lazy" decoding="async" />
          <div><span class="status">{game.status}</span><h3>{game.name}</h3><p>{game.description}</p>{game.internal ? (
            <a href={game.href}>{game.linkLabel} <span aria-hidden="true">→</span></a>
          ) : (
            <a href={game.href} target="_blank" rel="noopener noreferrer">Play {game.name} <span aria-hidden="true">↗</span></a>
          )}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="lab-panel shell" aria-labelledby="lab-title">
    <div class="lab-intro"><p class="eyebrow">03 / Experimental Lab</p><h2 id="lab-title">Ideas in motion.</h2><p>The Lab holds more playable prototypes, playtests and games still in development. Each listing shows its current status.</p></div>
    <div class="lab-grid">
      <article><img src="/images/games/gladiator-mayhem/showcase.webp" alt="Gladiator Mayhem arena: Barry lands an axe swing on Dr Stitch" width="1600" height="1000" loading="lazy" decoding="async" /><div><span class="status">Play now</span><h3>Gladiator Mayhem</h3><p>Choose three ridiculous actions, arrange their order and watch the tactical chaos unfold.</p><a href="https://gladiator-mayhem.pages.dev/" target="_blank" rel="noopener noreferrer">Play Gladiator Mayhem <span aria-hidden="true">↗</span></a></div></article>
      <article><img src="/images/games/lamplighter/showcase.webp" alt="Three Lamplighter levels on foggy Victorian streets, lighting lamps to freeze monsters" width="1600" height="1000" loading="lazy" decoding="async" /><div><span class="status">In development</span><h3>Lamplighter</h3><p>A Victorian lamplighter crosses foggy streets, lighting lamps to freeze monsters. Light every one at once to win.</p></div></article>
      <article><img src="/images/games/mirror-court/showcase.webp" alt="Three Mirror Court rooms: the Courtier's court above and its mirrored Reflection below" width="1600" height="1000" loading="lazy" decoding="async" /><div><span class="status">In development</span><h3>Mirror Court</h3><p>Every move you make, your reflection makes too. Pin one figure against a wall so both reach their doors together.</p></div></article>
    </div>
    <div class="lab-actions"><a class="button button-primary" href="/lab/">Explore The Lab <span aria-hidden="true">→</span></a><a href="/playtests/join/">Request a playtest invitation</a></div>
  </section>
</BaseLayout>

<style>
  :global(#main-content) { background: radial-gradient(circle at 82% 7%, rgba(255,122,95,.13), transparent 28%), #090e12; }
  .games-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(220px, .6fr); gap: 34px; align-items: center; padding-block: clamp(70px, 9vw, 125px) 95px; }
  h1, h2, h3 { letter-spacing: -.035em; }
  h1 { margin: 0; font-size: clamp(3.1rem, 7vw, 6.8rem); line-height: .98; }
  h1 em { color: #ff9b7f; font-family: Georgia, serif; font-weight: 400; }
  .games-hero p:not(.eyebrow) { max-width: 640px; margin: 27px 0; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .graham-art { display: grid; place-items: center; min-height: 300px; border: 1px solid var(--line); border-radius: 20px; background: radial-gradient(circle at 50% 70%, rgba(255,155,127,.2), transparent 65%), #141927; }
  .graham-art img { width: min(80%, 343px); height: auto; }
  .game-section { padding-bottom: 90px; }
  .section-heading { margin-bottom: 25px; }
  h2 { margin: 0; font-size: clamp(2.2rem, 4vw, 3.8rem); }
  .featured-grid, .playable-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .featured-card, .playable-card { overflow: hidden; border: 1px solid var(--line-strong); border-radius: 16px; background: #111923; }
  .game-art { position: relative; background: #151b26; }
  .game-art img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; }
  .game-copy, .playable-card > div { padding: clamp(24px, 3vw, 34px); }
  .status { color: #ffc19f; font: 700 .72rem ui-monospace, monospace; letter-spacing: .11em; text-transform: uppercase; }
  h3 { margin: 11px 0; font-size: clamp(1.6rem, 2.8vw, 2.4rem); }
  .featured-card p, .playable-card p, .lab-panel p:not(.eyebrow) { color: var(--muted); line-height: 1.65; }
  .featured-card a, .playable-card a, .lab-actions > a:not(.button) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #ffd0b5; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .playable-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .playable-card > img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; }
  .lab-panel { padding-block: 45px 90px; border-top: 1px solid var(--line-strong); }
  .lab-intro { max-width: 680px; }
  .lab-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin: 28px 0; }
  .lab-grid article { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 16px; background: #131925; }
  .lab-grid article > img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; }
  .lab-grid article > div { padding: clamp(24px, 3vw, 34px); }
  .lab-grid h3 { font-size: clamp(1.5rem, 2.7vw, 2.2rem); }
  .lab-grid a { display: inline-flex; align-items: center; min-height: 44px; color: #ffd0b5; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .lab-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px; }
  @media (max-width: 900px) { .games-hero { grid-template-columns: 1fr; } .graham-art { display: none; } .playable-grid, .lab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 650px) { .games-hero { padding-bottom: 65px; } .featured-grid, .playable-grid, .lab-grid { grid-template-columns: 1fr; } .game-section { padding-bottom: 65px; } }
</style>
