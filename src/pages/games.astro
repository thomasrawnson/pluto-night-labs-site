---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  {
    name: 'Personal Effects',
    status: 'Play now',
    description: "Pack a stranger's final belongings into one suitcase while obeying the requests they left behind.",
    image: '/images/games/personal-effects/featured.webp',
    alt: "Personal Effects gameplay showing a suitcase packed with the Magician's belongings",
    href: 'https://personal-effects.pages.dev/',
  },
  {
    name: 'Gladiator Mayhem',
    status: 'Play now',
    description: 'Choose three ridiculous actions, arrange their order and watch the tactical chaos unfold.',
    image: '/lab/gladiator-mayhem.svg',
    alt: 'Concept illustration for Gladiator Mayhem',
    href: 'https://gladiator-mayhem.pages.dev/',
    concept: true,
  },
];
const playable = [
  { name: 'Night Parcel Office', description: 'Sort suspicious late-night parcels by the regulations.', image: '/images/games/night-parcel-office/featured.webp', alt: 'Night Parcel Office parcel-routing gameplay', href: 'https://night-parcel-office.pages.dev/' },
  { name: 'Anomaly Lab', description: 'Inspect specimens, learn the rules and make the call.', image: '/images/games/anomaly-lab/featured.webp', alt: 'Anomaly Lab specimen-selection gameplay', href: 'https://anomaly-lab.pages.dev/' },
];
---

<BaseLayout title="Games | Pluto Night Labs" description="Original games and experiments from Pluto Night Labs, including playable prototypes, a microgames preview and work in progress.">
  <section class="games-hero shell">
    <div>
      <p class="eyebrow">Pluto Night Labs / Games</p>
      <h1>Strange ideas.<br /><em>Ready to play.</em></h1>
      <p>Original games from the studio, from playable browser prototypes to experiments still taking shape.</p>
      <a class="button button-primary" href="#featured-games">Explore the games <span aria-hidden="true">↓</span></a>
    </div>
    <div class="graham-art"><img src="/team/graham.png" alt="Graham, the Pluto Night Labs mascot" width="343" height="282" decoding="async" /></div>
  </section>

  <section class="game-section shell" id="featured-games" aria-labelledby="featured-title">
    <div class="section-heading"><p class="eyebrow">01 / Featured Games</p><h2 id="featured-title">Start somewhere unusual.</h2></div>
    <div class="featured-grid">
      {featured.map((game) => (
        <article class="featured-card">
          <div class="game-art"><img src={game.image} alt={game.alt} width="800" height="500" loading="lazy" decoding="async" />{game.concept && <span class="art-label">Concept illustration</span>}</div>
          <div class="game-copy"><span class="status">{game.status}</span><h3>{game.name}</h3><p>{game.description}</p><a href={game.href} target="_blank" rel="noopener noreferrer">Play {game.name} <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
    </div>
  </section>

  <section class="game-section shell" aria-labelledby="playable-title">
    <div class="section-heading"><p class="eyebrow">02 / Playable Games</p><h2 id="playable-title">More worlds to try.</h2></div>
    <div class="playable-grid">
      {playable.map((game) => (
        <article class="playable-card">
          <img src={game.image} alt={game.alt} width="800" height="500" loading="lazy" decoding="async" />
          <div><span class="status">Play now</span><h3>{game.name}</h3><p>{game.description}</p><a href={game.href} target="_blank" rel="noopener noreferrer">Play {game.name} <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
      <article class="collection-card"><span class="status">Play now</span><h3>Microgames</h3><p>Quick decisions, odd little disasters and a growing collection of short games.</p><a href="/microgames/">Explore Microgames <span aria-hidden="true">→</span></a></article>
    </div>
  </section>

  <section class="lab-panel shell" aria-labelledby="lab-title">
    <div class="lab-intro"><p class="eyebrow">03 / Experimental Lab</p><h2 id="lab-title">Ideas in motion.</h2><p>The Lab holds more playable prototypes, playtests and games still in development. Each listing shows its current status.</p></div>
    <div class="lab-grid">
      <article><span class="status">Play now</span><h3>Word Lab</h3><p>Three cosy word-game experiments: Distill, Shelf Sort and Chain Reaction.</p><a href="https://wl-m3-04.word-lab-playtest.pages.dev/" target="_blank" rel="noopener noreferrer">Open Word Lab playtest <span aria-hidden="true">↗</span></a></article>
      <article><span class="status">In development</span><h3>Necromancer's Horde</h3><p>An undead-army strategy experiment still taking shape. No public play link is available here.</p></article>
    </div>
    <div class="lab-actions"><a class="button button-primary" href="/lab/">Explore The Lab <span aria-hidden="true">→</span></a><a href="/playtests/join/">Request a playtest invitation</a></div>
  </section>
</BaseLayout>

<style>
  :global(#main-content) { background: radial-gradient(circle at 82% 7%, rgba(255,122,95,.13), transparent 28%), #090e12; }
  .games-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(220px, .6fr); gap: 34px; align-items: center; padding-block: clamp(70px, 9vw, 125px) 95px; }
  h1, h2, h3 { letter-spacing: -.035em; }
  h1 { margin: 0; font-size: clamp(3.1rem, 7vw, 6.8rem); line-height: .98; }
  h1 em { color: #ff9b7f; font-family: Georgia, serif; font-weight: 400; }
  .games-hero p:not(.eyebrow) { max-width: 640px; margin: 27px 0; color: var(--muted); font-size: 1.1rem; line-height: 1.7; }
  .graham-art { display: grid; place-items: center; min-height: 300px; border: 1px solid var(--line); border-radius: 20px; background: radial-gradient(circle at 50% 70%, rgba(255,155,127,.2), transparent 65%), #141927; }
  .graham-art img { width: min(80%, 343px); height: auto; }
  .game-section { padding-bottom: 90px; }
  .section-heading { margin-bottom: 25px; }
  h2 { margin: 0; font-size: clamp(2.2rem, 4vw, 3.8rem); }
  .featured-grid, .playable-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .featured-card, .playable-card, .collection-card { overflow: hidden; border: 1px solid var(--line-strong); border-radius: 16px; background: #111923; }
  .game-art { position: relative; background: #151b26; }
  .game-art img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; }
  .art-label { position: absolute; right: 14px; bottom: 14px; padding: 5px 9px; border-radius: 4px; background: rgba(8,12,20,.9); color: var(--text); font-size: .74rem; }
  .game-copy, .playable-card > div, .collection-card { padding: clamp(24px, 3vw, 34px); }
  .status { color: #ffc19f; font: 700 .72rem ui-monospace, monospace; letter-spacing: .11em; text-transform: uppercase; }
  h3 { margin: 11px 0; font-size: clamp(1.6rem, 2.8vw, 2.4rem); }
  .featured-card p, .playable-card p, .collection-card p, .lab-panel p:not(.eyebrow) { color: var(--muted); line-height: 1.65; }
  .featured-card a, .playable-card a, .collection-card a, .lab-actions > a:not(.button) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #ffd0b5; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .playable-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .playable-card > img { width: 100%; aspect-ratio: 8 / 5; object-fit: cover; }
  .collection-card { display: flex; flex-direction: column; justify-content: flex-end; background: radial-gradient(circle at 70% 20%, rgba(255,122,95,.17), transparent 45%), #18202d; }
  .lab-panel { padding-block: 45px 90px; border-top: 1px solid var(--line-strong); }
  .lab-intro { max-width: 680px; }
  .lab-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 28px 0; }
  .lab-grid article { padding: clamp(24px, 3vw, 34px); border: 1px solid var(--line-strong); border-radius: 16px; background: #131925; }
  .lab-grid h3 { font-size: clamp(1.5rem, 2.7vw, 2.2rem); }
  .lab-grid a { display: inline-flex; align-items: center; min-height: 44px; color: #ffd0b5; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .lab-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px; }
  @media (max-width: 900px) { .games-hero { grid-template-columns: 1fr; } .graham-art { display: none; } .playable-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 650px) { .games-hero { padding-bottom: 65px; } .featured-grid, .playable-grid, .lab-grid { grid-template-columns: 1fr; } .game-section { padding-bottom: 65px; } }
</style>
