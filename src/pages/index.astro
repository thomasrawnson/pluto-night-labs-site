---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pluto Night Labs — Useful apps. Strange games." description="Pluto Night Labs is an independent UK studio creating practical apps and unusual experimental games. Explore tools and playable prototypes.">
  <section class="hero" id="home">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent UK studio</p>
        <h1>Useful apps.<br />Strange games.<br /><em>Built with curiosity.</em></h1>
        <p class="intro">An independent UK studio creating practical software and experimental games.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#featured">Explore our work <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="#games">Play the games</a>
        </div>
      </div>
      <div class="orbit-scene" id="orbit-scene" aria-label="Interactive Pluto orbital display">
        <div class="scope-line scope-x"></div><div class="scope-line scope-y"></div>
        <div class="scope-ring ring-one"></div><div class="scope-ring ring-two"></div>
        <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
        <div class="pluto" aria-hidden="true"></div>
        <div class="orbit-front orbit-front-one" aria-hidden="true"></div>
        <div class="orbit-front orbit-front-two" aria-hidden="true"></div>
        <button class="moon moon-one" type="button" aria-label="Move the first moon into a new orbit"></button>
        <button class="moon moon-two" type="button" aria-label="Move the second moon into a new orbit"></button>
        <button class="moon moon-three" type="button" aria-label="Move the third moon into a new orbit"></button>
        <p class="scope-hint">TAP A MOON<br />TO CHANGE ORBIT</p>
        <p class="scope-readout" id="scope-readout" aria-live="polite">ORBIT // STABLE</p>
      </div>
    </div>
  </section>

  <div class="telemetry shell" aria-label="Studio information">
    <div class="telemetry-left"><span class="status-light" aria-hidden="true"></span><span>PLUTO NIGHT LABS</span><span class="slash">//</span><span>SYSTEMS: NOMINAL</span></div>
    <span class="telemetry-center">INDEPENDENT UK STUDIO</span>
    <span class="telemetry-right">APPS FOR REAL LIFE. GAMES FOR ELSEWHERE.</span>
  </div>

  <section class="featured shell" id="featured" aria-labelledby="featured-title">
    <div class="section-head"><p class="section-label" id="featured-title">FEATURED PROJECTS</p><span class="section-rule"></span><span class="section-count">// 03</span></div>
    <div class="product-grid">
      <article class="product-card shelfpick-card">
        <div class="project-art shelfpick-art" aria-hidden="true">
          <div class="box-stack"><div class="box-one">GAME NIGHT</div><div class="box-two">SHELF PICK</div><div class="box-three">PLAY MORE</div></div>
          <span class="meeple"></span>
        </div>
        <div class="product-content">
          <div><h2>ShelfPick</h2><p>Discover your next<br />favourite game.</p><span class="project-kind"><i></i> APP · COMING SOON</span></div>
          <a class="round-link" href="/products/#shelfpick" aria-label="Explore ShelfPick">→</a>
        </div>
      </article>
      <article class="product-card usage-card">
        <div class="project-art usage-art" aria-hidden="true">
          <div class="mini-window"><div class="mini-title">USAGEGRID <span>●</span></div><div class="mini-chart"><i style="height:30%"></i><i style="height:54%"></i><i style="height:42%"></i><i style="height:72%"></i><i style="height:58%"></i><i style="height:90%"></i><i style="height:65%"></i><i style="height:78%"></i></div><div class="mini-footer">TODAY 46% &nbsp; WEEK 68%</div></div>
        </div>
        <div class="product-content">
          <div><h2>UsageGrid</h2><p>Your AI coding usage,<br />at a glance.</p><span class="project-kind"><i></i> APP · IN DEVELOPMENT</span></div>
          <a class="round-link" href="/products/#usagegrid" aria-label="Explore UsageGrid">→</a>
        </div>
      </article>
      <article class="product-card night-card">
        <div class="project-art parcel-art" aria-hidden="true">
          <div class="parcel-shadow"></div><div class="parcel-box"><span class="parcel-tape"></span><b>NPO</b><small>NIGHT PARCEL OFFICE</small><span class="parcel-barcode">▥▥▥▥▥▥▥▥</span></div>
        </div>
        <div class="product-content">
          <div><h2>Night Parcel Office</h2><p>Sort. Follow the rules.<br />Survive the shift.</p><span class="project-kind game-kind"><i></i> GAME · PLAYABLE PROTOTYPE</span></div>
          <a class="round-link" href="/lab/#night-parcel-office" aria-label="Explore Night Parcel Office">→</a>
        </div>
      </article>
    </div>
  </section>

  <section class="games shell" id="games" aria-labelledby="games-title">
    <div class="section-head"><p class="section-label" id="games-title">MORE FROM THE LAB</p><span class="section-rule"></span><a class="all-games" href="/lab/">ALL EXPERIMENTS ↗</a></div>
    <div class="game-grid">
      <a class="game-row" href="/lab/#personal-effects">
        <span class="game-art effects-art" aria-hidden="true">P.E.<small>FINAL TRANSIT</small></span>
        <span class="game-copy"><strong>Personal Effects</strong><small>Pack what matters.</small></span><span class="game-arrow">→</span>
      </a>
      <a class="game-row" href="/lab/#anomaly-lab">
        <span class="game-art anomaly-art" aria-hidden="true"><span class="specimen">?</span></span>
        <span class="game-copy"><strong>Anomaly Lab</strong><small>Find the hidden rule.</small></span><span class="game-arrow">→</span>
      </a>
      <a class="game-row" href="/playtests/going-going-ghoul/">
        <span class="game-art ghoul-art" aria-hidden="true"><span>SOLD?</span></span>
        <span class="game-copy"><strong>Going, Going, Ghoul!</strong><small>Cursed auctions.</small></span><span class="game-arrow">→</span>
      </a>
    </div>
    <div class="other-games"><span>ALSO EXPERIMENTING WITH</span><a href="/lab/#tiny-heist-planner">Tiny Heist Planner ↗</a><a href="/lab/#gladiator-mayhem">Gladiator Mayhem ↗</a></div>
  </section>

  <section class="about-compact shell" id="about">
    <p>Small studio. Big curiosity.</p>
    <a href="/contact/">Have an idea? Get in touch ↗</a>
  </section>
</BaseLayout>

<script>
  const moons = document.querySelectorAll<HTMLButtonElement>('.moon');
  const readout = document.getElementById('scope-readout');
  const scene = document.getElementById('orbit-scene');
  const angles = [0, 0, 0];
  moons.forEach((moon, index) => {
    moon.addEventListener('click', () => {
      angles[index] = (angles[index] + 74) % 360;
      moon.style.setProperty('--offset', angles[index] + 'deg');
      if (readout) readout.textContent = 'MOON ' + (index + 1) + ' // ORBIT UPDATED';
    });
  });
  // Small motion-only response; no scrolling interception or global custom cursor.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    scene?.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const rect = scene.getBoundingClientRect();
      scene.style.setProperty('--pointer-x', (((event.clientX - rect.left) / rect.width) - .5).toFixed(3));
    });
    scene?.addEventListener('pointerleave', () => scene.style.setProperty('--pointer-x', '0'));
  }
</script>

<style>
  :global(body) { background: #090e12; }
  :global(main) { background-color: #090e12; background-image: radial-gradient(circle at 57% 9%, rgba(205,112,55,.07),transparent 26%),radial-gradient(rgba(215,227,215,.10) .5px,transparent .7px); background-size: auto, 67px 71px; }
  .hero { padding: 62px 0 33px; }
  .hero-grid { display:grid; grid-template-columns: 1fr 1fr; align-items:center; gap: 30px; min-height: 435px; }
  .eyebrow,.section-label,.section-count,.all-games,.telemetry,.scope-hint,.scope-readout,.project-kind,.other-games { font-family: ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.12em; }
  .eyebrow { margin:0 0 22px; font-size:.7rem; font-weight:700; }
  h1 { margin:0; font-size:clamp(2.7rem,4.8vw,5rem); line-height:1.04; letter-spacing:-.058em; font-weight:780; }
  h1 em { color:#fa8961; font-style:normal; white-space:nowrap; }
  .intro { max-width:380px; color:#c0c2c6; font-size:1.02rem; line-height:1.65; margin:22px 0 0; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:13px; margin-top:28px; }
  .button { min-height:46px; border-radius:7px; font-size:.83rem; }
  .button-primary { background:#ff9169; background-image:none; box-shadow:none; }
  .button-secondary { background:#0e1418; }
  .hero-actions .button span { margin-left:12px; }
  .orbit-scene { position:relative; width:100%; max-width:500px; aspect-ratio:1.15; margin:auto; isolation:isolate; --pointer-x:0; }
  .scope-ring { position:absolute; border:1px solid rgba(225,143,88,.13); border-radius:50%; aspect-ratio:1; left:50%; top:50%; transform:translate(-50%,-50%); pointer-events:none; }
  .ring-one { width:88%; }.ring-two { width:62%; border-style:dashed; opacity:.7; }
  .scope-line { position:absolute; background:rgba(233,156,100,.18); pointer-events:none; }
  .scope-x { left:3%; right:3%; height:1px; top:50%; }.scope-y { width:1px; top:5%; bottom:5%; left:50%; }
  /* Centred, complete orbit ellipses; lower front arcs pass in front of Pluto. */
  .orbit, .orbit-front { position:absolute; left:50%; top:50%; width:90%; height:48%; border-radius:50%; pointer-events:none; transform-origin:center; }
  .orbit { z-index:0; border:1px solid rgba(250,151,91,.5); }
  .orbit-one,.orbit-front-one { transform:translate(-50%,-50%) rotate(-24deg); }
  .orbit-two,.orbit-front-two { width:77%; height:47%; transform:translate(-50%,-50%) rotate(57deg); }
  .orbit-two { opacity:.7; border-color:rgba(250,151,91,.46); }
  .orbit-front { z-index:2; border:1px solid transparent; border-bottom-color:rgba(250,151,91,.62); }
  .orbit-front-two { border-bottom-color:rgba(250,151,91,.48); }
  .pluto { z-index:1; position:absolute; width:45%; aspect-ratio:1; left:27.5%; top:26%; border-radius:50%; background:radial-gradient(ellipse at 25% 27%, #f1c29a 0, #b67b58 14%, #534443 35%, #1d2228 62%, #0b1118 80%); box-shadow:inset -30px -16px 38px #070b10, 0 0 35px rgba(235,138,73,.1); transform:translateX(calc(var(--pointer-x) * 7px)); pointer-events:none; }
  .moon { position:absolute; z-index:2; width:22px; height:22px; border:1px solid #a69488; border-radius:50%; background:radial-gradient(circle at 30% 24%,#e6d0b1,#5b5c63 65%,#111820); box-shadow:0 0 12px #000; cursor:pointer; transition:transform .25s ease, box-shadow .2s ease; }
  .moon:hover,.moon:focus-visible { box-shadow:0 0 0 5px rgba(255,143,90,.13),0 0 20px rgba(255,143,90,.4); }
  .moon-one { left:10%; top:62%; transform:rotate(var(--offset,0deg)) translateX(15px); }
  .moon-two { right:14%; top:13%; transform:rotate(var(--offset,0deg)) translateX(15px); }
  .moon-three { right:17%; bottom:24%; width:15px; height:15px; background:#ffad67; border-color:#ffc496; box-shadow:0 0 17px #e87c43; transform:rotate(var(--offset,0deg)) translateX(15px); }
  .scope-hint { position:absolute; right:0; bottom:4%; color:#9e9996; font-size:.6rem; line-height:1.6; }
  .scope-readout { position:absolute; left:3%; bottom:4%; color:#8d9f91; font-size:.58rem; }
  .telemetry { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; padding-block:14px; border-block:1px solid rgba(255,255,255,.16); color:#8ddb9b; font-size:.63rem; }
  .telemetry-left { display:flex; align-items:center; flex-wrap:wrap; gap:13px; }
  .status-light { width:7px; height:7px; border-radius:50%; background:#70dc87; box-shadow:0 0 8px rgba(111,220,132,.4); }
  .slash { color:#56745c; }.telemetry-center,.telemetry-right { color:#a8aab0; }
  .featured,.games { padding-top:39px; }
  .section-head { display:flex; align-items:center; gap:19px; margin-bottom:19px; }
  .section-label { margin:0; flex-shrink:0; font-size:.72rem; color:#e7e1db; }
  .section-label::before { content:''; display:inline-block; width:19px; height:2px; margin:0 13px 3px 0; background:#ff8c61; }
  .section-rule { height:1px; background:rgba(255,255,255,.13); flex:1; }
  .section-count,.all-games { font-size:.66rem; color:#a6a8aa; }
  .all-games:hover { color:#ff9871; }
  .product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .product-card { min-width:0; display:flex; flex-direction:column; border:1px solid rgba(255,255,255,.17); border-radius:6px; overflow:hidden; background:#0a1014; transition:border-color .15s ease; }
  .product-card:hover { border-color:rgba(255,153,109,.55); }
  .project-art { position:relative; display:grid; place-items:center; height:178px; overflow:hidden; background:#10171b; border-bottom:1px solid rgba(255,255,255,.09); }
  .shelfpick-art { background:radial-gradient(ellipse at 52% 76%,#4d3931,#181b1c 74%); }
  .box-stack { position:relative; width:53%; max-width:180px; height:112px; transform:rotate(-6deg); }
  .box-stack > div { position:absolute; left:5%; width:91%; height:34px; padding:7px 12px; border:2px solid #614a3b; font:800 .69rem Georgia,serif; letter-spacing:.08em; color:#cfa577; box-shadow:3px 6px 12px #0008; }
  .box-one { top:2px; background:#283941; }.box-two { top:37px; background:#604337; }.box-three { top:72px; background:#2d3439; }
  .meeple { position:absolute; right:17%; bottom:14%; width:30px; height:43px; clip-path:polygon(38% 0,63% 0,78% 27%,100% 43%,78% 57%,72% 100%,28% 100%,22% 57%,0 43%,22% 27%); background:#c6a078; filter:drop-shadow(3px 4px 3px #0009); }
  .usage-art { background:radial-gradient(ellipse at 52% 73%,#323b39,#151b1c 75%); }
  .mini-window { width:52%; min-width:160px; max-width:205px; padding:10px 12px; border:4px solid #464e4b; border-radius:10px; background:#111b1c; box-shadow:8px 13px 18px #0008; }
  .mini-title,.mini-footer { color:#d6ad78; font:700 .55rem ui-monospace,monospace; letter-spacing:.08em; }
  .mini-title { display:flex; justify-content:space-between; }.mini-title span { color:#d59c62; }
  .mini-chart { display:flex; align-items:end; gap:5px; height:65px; padding:12px 0 4px; border-bottom:1px solid #3c4d45; }
  .mini-chart i { flex:1; min-width:0; background:#dc985d; }.mini-footer { font-size:.46rem; margin-top:8px; }
  .parcel-art { background:radial-gradient(ellipse at 50% 90%,#4b3526,#151a1b 72%); }
  .parcel-shadow { position:absolute; width:53%; height:17px; bottom:13%; border-radius:50%; background:#050607; filter:blur(12px); }
  .parcel-box { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; width:49%; max-width:178px; height:112px; border:2px solid #987453; background:linear-gradient(135deg,#ad8560,#7d6047); box-shadow:8px 9px 17px #0009; transform:rotate(-2deg); color:#30251f; }
  .parcel-box b { font:900 2.6rem/1 ui-monospace,monospace; }.parcel-box small { font:750 .49rem ui-monospace,monospace; }
  .parcel-tape { position:absolute; left:45%; width:20%; height:100%; background:rgba(219,188,137,.35); border-inline:1px solid #60432d; }
  .parcel-barcode { position:absolute; bottom:5px; font-size:1.3rem; letter-spacing:-.15em; }
  .product-content { display:flex; align-items:end; justify-content:space-between; gap:9px; padding:18px 19px 20px; min-height:140px; }
  .product-content h2 { margin:0 0 6px; font-size:1.25rem; letter-spacing:-.03em; }
  .product-content p { margin:0; color:#b6b8bb; font-size:.85rem; line-height:1.55; }
  .project-kind { display:flex; align-items:center; gap:9px; margin-top:13px; color:#75e08b; font-size:.64rem; }
  .project-kind i { width:7px; height:7px; border-radius:50%; background:currentColor; }.game-kind { color:#ff9267; }
  .round-link,.game-arrow { flex-shrink:0; display:grid; place-items:center; width:37px; height:37px; border:1px solid #828386; border-radius:50%; font-size:1.25rem; }
  .round-link:hover { background:#ff986f; color:#111; border-color:#ff986f; }
  .games { padding-bottom:32px; }
  .game-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:23px; }
  .game-row { display:flex; align-items:center; min-width:0; gap:13px; padding-block:5px; }
  .game-row:hover strong { color:#ffa681; }
  .game-art { width:85px; height:85px; flex:0 0 85px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.15); border-radius:6px; font-family:Georgia,serif; }
  .effects-art { background:#302922; color:#e1bc91; font-size:1.5rem; font-weight:bold; }.effects-art small { display:block; margin-top:-31px; font:700 .39rem ui-monospace,monospace; }
  .anomaly-art { background:#122821; }.specimen { width:39px; height:50px; display:grid; place-items:center; border:2px solid #4bbd86; border-radius:12px; color:#8de5ad; font-size:2rem; background:#175339; box-shadow:0 0 13px #237d4d77; }
  .ghoul-art { background:#302118; }.ghoul-art span { padding:8px 6px; border:2px solid #bd9467; transform:rotate(-12deg); color:#e9bc83; font:800 .8rem ui-monospace,monospace; }
  .game-copy { flex:1; min-width:0; }.game-copy strong { display:block; font-size:.85rem; }.game-copy small { display:block; margin-top:8px; color:#a9adb0; font-size:.77rem; }
  .game-arrow { width:29px; height:29px; font-size:1rem; }
  .other-games { display:flex; align-items:center; flex-wrap:wrap; gap:18px; margin-top:26px; border-top:1px solid #ffffff18; padding-top:17px; color:#a7adae; font-size:.6rem; }
  .other-games a { color:#e4dfda; }.other-games a:hover { color:#ff9a70; }
  .about-compact { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; border-top:1px solid #ffffff1b; padding-block:20px 34px; color:#aab0b3; font-size:.8rem; }
  .about-compact p { margin:0; }.about-compact a { color:#e6a58b; }
  @media(max-width:920px) { .hero-grid { grid-template-columns:1fr; }.orbit-scene { max-width:450px; }.product-grid { gap:12px; }.game-grid { grid-template-columns:1fr; gap:12px; }.product-content { padding:15px; }.project-art { height:155px; }.product-content h2 { font-size:1.1rem; } }
  @media(max-width:660px) { .hero { padding-top:46px; }.hero-grid { gap:3px; }.hero h1 { font-size:clamp(2.5rem,9vw,3.8rem); }.hero h1 em { white-space:normal; }.orbit-scene { max-width:360px; }.telemetry { font-size:.57rem; }.telemetry-center { display:none; }.telemetry-right { width:100%; }.product-grid { grid-template-columns:1fr; }.product-card { display:grid; grid-template-columns:115px minmax(0,1fr); }.project-art { height:100%; min-height:142px; border:0; border-right:1px solid #ffffff18; }.box-stack { transform:scale(.72) rotate(-6deg); width:110%; }.meeple { display:none; }.mini-window { transform:scale(.67); min-width:150px; }.parcel-box { transform:scale(.77) rotate(-2deg); width:110%; min-width:125px; }.product-content { min-height:145px; }.section-head { gap:8px; }.section-label { font-size:.65rem; }.game-row { border-bottom:1px solid #ffffff12; }.other-games { align-items:start; }.other-games span { width:100%; } }
  @media(max-width:360px) { .product-card { grid-template-columns:100px minmax(0,1fr); }.product-content { padding:12px; }.product-content p { font-size:.78rem; }.hero-actions .button { font-size:.75rem; padding-inline:14px; }.game-art { width:66px; height:66px; flex-basis:66px; }.game-arrow { display:none; } }
  @media(prefers-reduced-motion:reduce){ .moon,.pluto { transition:none; transform:none; } }
  @media(max-width:660px) { .project-kind { font-size:.58rem; letter-spacing:.07em; } }
</style>