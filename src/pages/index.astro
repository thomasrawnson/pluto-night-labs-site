---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';



---

<BaseLayout>
  <section class="hero" id="home">
    <div class="stars" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span></span> Independent software studio</p>
        <h1>Useful apps.<br />Strange games.<br /><em>Built with curiosity.</em></h1>
        <p class="intro">Pluto Night Labs is an independent UK studio creating practical apps, experimental games and occasionally questionable ideas. We build things we'd want to use — or play.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#featured">Explore our products <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href="#games">Play our games <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="orbit-scene" aria-hidden="true">
        <div class="orbit orbit-one"><span></span></div>
        <div class="orbit orbit-two"><span></span></div>
        <div class="pluto">
          <span class="crater c1"></span><span class="crater c2"></span><span class="crater c3"></span>
          <span class="pluto-glow"></span>
        </div>
        <p class="coordinate">50.3755° N<br />4.1427° W</p>
      </div>
    </div>
  </section>

  <section class="studio-strip" aria-label="About the studio">
    <div class="shell studio-strip-inner">
      <span class="studio-mark" aria-hidden="true">PLUTO NIGHT LABS</span>
      <div>
        <h2>Independent by design. Curious by nature.</h2>
        <p>We're a small independent studio making software that solves problems and games that create interesting ones.</p>
      </div>
    </div>
  </section>

  <section class="products" id="featured" aria-labelledby="featured-title">
    <div class="shell">
      <p class="eyebrow">Featured projects</p>
      <div class="section-heading"><h2 class="section-title" id="featured-title">Useful tools. Unusual worlds.</h2><p class="section-intro">Two practical apps and one deeply suspicious night shift.</p></div>
      <div class="product-grid">
        <article class="product-card shelfpick-card">
          <div class="product-content">
            <span class="status"><i></i> Coming soon</span>
            <p class="product-label">ShelfPick</p>
            <h3>Spend less time choosing.<br />More time playing.</h3>
            <p class="product-description">A smarter companion for board game collections, recommendations and game nights.</p>
            <a class="feature-card-link" href="/products/#shelfpick">Explore ShelfPick <span aria-hidden="true">↗</span></a>
          </div>
          <div class="game-visual" aria-hidden="true">
            <div class="card-stack"><span></span><span></span><span></span></div>
            <div class="game-board">
              <span class="board-path"></span>
              <span class="tile t1"></span><span class="tile t2"></span><span class="tile t3"></span>
              <span class="meeple m1"></span><span class="meeple m2"></span>
              <span class="token token-one"></span><span class="token token-two"></span>
              <span class="dice"><i></i><i></i><i></i><i></i><i></i></span>
              <div class="pick-panel"><small>TONIGHT'S PICK</small><strong>Ready to play</strong><span>4 players · 45 min</span></div>
            </div>
          </div>
        </article>

        <article class="product-card usage-card">
          <div class="product-content">
            <span class="status"><i></i> In development</span>
            <p class="product-label">UsageGrid</p>
            <h3>Your AI coding usage,<br />at a glance.</h3>
            <p class="product-description">A lightweight macOS menu-bar utility for keeping track of developer-tool usage.</p>
            <a class="feature-card-link" href="/products/#usagegrid">Explore UsageGrid <span aria-hidden="true">↗</span></a>
          </div>
          <div class="usage-visual" aria-hidden="true">
            <div class="usage-window">
              <div class="window-head"><span>UsageGrid</span><i></i></div>
              <div class="usage-body">
                <div class="usage-summary"><small>THIS WEEK</small><strong>68%</strong></div>
                <div class="bar"><i style="width: 68%"></i></div>
                <div class="usage-row"><span>Today</span><div><i style="width: 46%"></i></div><b>46%</b></div>
                <div class="usage-row"><span>Week</span><div><i style="width: 68%"></i></div><b>68%</b></div>
                <div class="usage-row"><span>Month</span><div><i style="width: 33%"></i></div><b>33%</b></div>
              </div>
            </div>
          </div>
        </article>

        <article class="product-card night-card">
          <div class="product-content">
            <span class="status"><i></i> Prototype in development</span>
            <p class="product-label">Featured game</p>
            <h3>Night Parcel<br />Office</h3>
            <p class="product-description">The night shift is not going to plan. Sort suspicious parcels, follow changing regulations and try to survive another shift.</p>
            <a class="feature-card-link" href="/lab/#night-parcel-office">Explore the game <span aria-hidden="true">↗</span></a>
          </div>
          <div class="night-visual">
            <img src="/lab/night-parcel-office.png" alt="Night Parcel Office sorting-desk gameplay screenshot" loading="lazy" width="1200" height="675" />
            <span>From the playable prototype</span>
          </div>
        </article>
      </div>
      <a class="section-more-link" href="/products/">View the product catalogue <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="lab" id="games" aria-labelledby="games-title">
    <div class="lab-stars" aria-hidden="true"></div>
    <div class="shell lab-shell">
      <div class="lab-heading">
        <div>
          <p class="lab-eyebrow"><span>Pluto Night Labs</span><i aria-hidden="true">//</i> Games</p>
          <h2 class="section-title" id="games-title">Small games.<br />Terrible decisions.</h2>
        </div>
        <p>Unusual little games built around interesting systems, questionable choices and the consequences of getting things wrong.</p>
      </div>

      <div class="lab-grid">
        <article class="lab-card">
          <div class="lab-art">
            <span class="lab-status"><i aria-hidden="true"></i> Playable prototype</span>
            <img class="lab-screenshot" src="/lab/personal-effects.png" alt="Personal Effects suitcase-packing gameplay screenshot" width="1200" height="675" loading="lazy" decoding="async" />
          </div>
          <div class="lab-copy">
            <p class="lab-category">Packing puzzle</p>
            <h3>Personal Effects</h3>
            <p class="lab-hook">One suitcase. A lifetime of baggage.</p>
            <p class="lab-description">Pack a stranger's final belongings while following the rules and confronting the choices they left behind.</p>
            <a class="lab-feature-link" href="/lab/#personal-effects">Explore prototype <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="lab-card">
          <div class="lab-art">
            <span class="lab-status"><i aria-hidden="true"></i> Playable prototype</span>
            <img class="lab-screenshot" src="/lab/anomaly-lab.png" alt="Anomaly Lab strange-specimen inspection gameplay screenshot" width="1200" height="675" loading="lazy" decoding="async" />
          </div>
          <div class="lab-copy">
            <p class="lab-category">Logic &amp; deduction</p>
            <h3>Anomaly Lab</h3>
            <p class="lab-hook">The rules are hidden. The specimens aren't helping.</p>
            <p class="lab-description">Test unusual specimens, discover the logic and work out which experiments belong where.</p>
            <a class="lab-feature-link" href="/lab/#anomaly-lab">Explore prototype <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="lab-card">
          <div class="lab-art">
            <span class="lab-status"><i aria-hidden="true"></i> Early playtest</span>
            <img class="lab-screenshot" src="/lab/going-going-ghoul.svg" alt="Illustrated concept cover for Going, Going, Ghoul!" width="1200" height="675" loading="lazy" decoding="async" />
            <span class="art-disclaimer">Concept artwork</span>
          </div>
          <div class="lab-copy">
            <p class="lab-category">Cursed antique auction</p>
            <h3>Going, Going, Ghoul!</h3>
            <p class="lab-hook">One more bid. One more terrible idea.</p>
            <p class="lab-description">Auction cursed antiques, find combinations and sell at exactly the wrong moment.</p>
            <a class="lab-feature-link" href="/playtests/going-going-ghoul/">Play early prototype <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      </div>

      <div class="more-lab">
        <div class="more-lab-copy"><span>ALSO ON THE WORKBENCH</span><p>More ideas taking shape</p></div>
        <div class="more-lab-links">
          <a href="/lab/#tiny-heist-planner">Tiny Heist Planner <span aria-hidden="true">↗</span></a>
          <a href="/lab/#gladiator-mayhem">Gladiator Mayhem <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <a class="section-more-link lab-more-link" href="/lab/">Explore all games &amp; prototypes <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="about" id="about">
    <div class="shell about-grid">
      <div class="about-orbit" aria-hidden="true"><span></span><i></i></div>
      <div class="about-copy">
        <p class="eyebrow">About Pluto Night Labs</p>
        <h2 class="section-title">Curiosity is part of the job.</h2>
        <div class="about-text">
          <p>Pluto Night Labs Ltd is an independent UK software and game studio. We make focused tools for real problems and playful experiments built around surprising ideas.</p>
          <p>Whether it's board-game nights, development workflows or a deeply questionable night shift, we care about thoughtful systems, distinctive design and making things enjoyable to use.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="shell contact-panel">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2>Got something to say?</h2>
        <p>Questions about Pluto Night Labs or one of our products? We'd love to hear from you.</p>
      </div>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${site.supportEmail}`}>{site.supportEmail} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 760px; display: grid; align-items: center; padding: 80px 0 110px; overflow: hidden; background: radial-gradient(circle at 73% 44%, rgba(115,87,125,.2), transparent 28%), radial-gradient(ellipse at 18% 86%, rgba(41,52,85,.19), transparent 44%), linear-gradient(180deg, #090c16 0%, #0b0f1b 100%); }
  .hero::after { content: ''; position: absolute; inset: auto -10% -110px; height: 260px; border-top: 1px solid rgba(255,255,255,.075); border-radius: 50% 50% 0 0; background: radial-gradient(ellipse at 50% 0, rgba(255,122,95,.055), transparent 58%), linear-gradient(transparent, rgba(5,7,12,.48)); pointer-events: none; }
  .stars { position: absolute; inset: 0; opacity: .36; background-image: radial-gradient(circle, #fff 0 1px, transparent 1.2px), radial-gradient(circle, #fff 0 .7px, transparent 1px); background-size: 143px 137px, 89px 97px; background-position: 17px 28px, 50px 74px; mask-image: linear-gradient(90deg, transparent, #000 35%, #000); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 42px; }
  .hero-copy { padding-top: 18px; }
  .kicker { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; }
  .kicker span { width: 22px; height: 1px; background: var(--accent); }
  h1 { margin: 28px 0 26px; font-size: clamp(3.4rem, 6.5vw, 6.7rem); line-height: .91; letter-spacing: -.065em; font-weight: 730; }
  h1 em { color: var(--accent); font-style: normal; }
  .intro { max-width: 610px; color: var(--muted); font-size: clamp(1.02rem, 1.4vw, 1.2rem); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .button span { margin-left: 10px; }
  .orbit-scene { position: relative; aspect-ratio: 1; min-width: 430px; }
  .pluto { position: absolute; width: 44%; aspect-ratio: 1; left: 30%; top: 27%; border-radius: 50%; background: radial-gradient(circle at 34% 26%, #eee7dd 0 8%, transparent 9%), radial-gradient(circle at 38% 35%, #b8aaa7 0 5%, transparent 6%), radial-gradient(circle at 67% 61%, #817982 0 10%, transparent 11%), radial-gradient(circle at 45% 40%, #d9d0c8, #8d8790 58%, #5b5965 100%); box-shadow: inset -24px -20px 35px rgba(19,20,31,.42), 0 0 80px rgba(210,190,180,.08); }
  .pluto::after { content: ''; position: absolute; inset: 14% 8% 13% 10%; border-radius: 50%; background: linear-gradient(115deg, transparent 42%, rgba(255,255,255,.11), transparent 60%); transform: rotate(15deg); }
  .crater { position: absolute; border-radius: 50%; background: rgba(72,70,81,.24); box-shadow: inset 2px 2px 5px rgba(20,20,25,.2); }
  .c1 { width: 13%; height: 9%; left: 19%; top: 55%; transform: rotate(22deg); } .c2 { width: 8%; height: 8%; left: 66%; top: 27%; } .c3 { width: 12%; height: 7%; left: 59%; top: 74%; }
  .pluto-glow { position: absolute; inset: -50%; border-radius: 50%; background: radial-gradient(circle, rgba(255,142,112,.12), transparent 59%); }
  .orbit { position: absolute; left: 5%; top: 37%; width: 91%; height: 32%; border: 1px solid rgba(241,232,222,.34); border-radius: 50%; transform: rotate(-28deg); }
  .orbit-one span { position: absolute; width: 13px; height: 13px; left: 6%; top: 60%; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 8px rgba(255,122,95,.065), 0 0 22px rgba(255,122,95,.46); }
  .orbit-two { left: 18%; top: 23%; width: 66%; height: 55%; opacity: .25; transform: rotate(63deg); }
  .orbit-two span { position: absolute; width: 5px; height: 5px; right: 5%; top: 30%; border-radius: 50%; background: var(--text); }
  .coordinate { position: absolute; right: 2%; bottom: 14%; color: var(--dim); font: 600 .62rem/1.7 ui-monospace, monospace; letter-spacing: .12em; }

  .studio-strip { position: relative; z-index: 2; padding: 36px 0; border-block: 1px solid rgba(255,255,255,.11); background: linear-gradient(90deg, #0d111d, #111623 50%, #0d111d); }
  .studio-strip-inner { display: flex; align-items: center; gap: clamp(20px, 5vw, 70px); }
  .studio-mark { flex: 0 0 auto; color: var(--accent-soft); font: 800 1.2rem ui-monospace, monospace; letter-spacing: .13em; }
  .studio-strip h2 { margin: 0 0 5px; font-size: clamp(1rem, 2vw, 1.22rem); letter-spacing: -.02em; }
  .studio-strip p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }

  .products { position: relative; padding: 140px 0 150px; overflow: hidden; background: radial-gradient(circle at 10% 35%, rgba(54,66,105,.11), transparent 31%), radial-gradient(circle at 90% 74%, rgba(255,122,95,.055), transparent 26%), linear-gradient(180deg, #090c16, #0b0e18); }
  .products::before { content: ''; position: absolute; width: 720px; height: 250px; left: -330px; top: 90px; border: 1px solid rgba(255,255,255,.055); border-radius: 50%; transform: rotate(-18deg); pointer-events: none; }
  .products > :global(.shell) { position: relative; z-index: 1; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 42px; }
  .section-intro { max-width: 320px; margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.65; }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .product-card { position: relative; min-height: 590px; border: 1px solid rgba(255,255,255,.12); border-radius: 30px; overflow: hidden; background: var(--surface); box-shadow: 0 30px 70px rgba(0,0,0,.29), inset 0 1px rgba(255,255,255,.035); }
  .product-card::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(135deg, rgba(255,255,255,.055), transparent 32%, transparent 70%, rgba(0,0,0,.09)); }
  .product-card::after { content: ''; position: absolute; width: 250px; height: 250px; right: -150px; bottom: -150px; border: 1px solid rgba(255,255,255,.08); border-radius: 50%; pointer-events: none; }
  .product-content { position: relative; z-index: 2; padding: 40px 38px 25px; }
  .status { display: inline-flex; align-items: center; gap: 8px; padding: 7px 11px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: rgba(0,0,0,.13); font-size: .67rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .product-label { margin: 36px 0 13px; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .18em; text-transform: uppercase; }
  .product-card h3 { margin: 0; font-size: clamp(2rem, 2.6vw, 2.75rem); line-height: 1; letter-spacing: -.05em; }
  .product-description { max-width: 450px; margin: 18px 0 0; color: var(--muted); line-height: 1.6; }
  .feature-card-link { display: inline-flex; gap: 12px; align-items: center; min-height: 44px; margin-top: 16px; border-bottom: 1px solid rgba(255,122,95,.5); color: #ffb49b; font-size: .82rem; font-weight: 750; }
  .feature-card-link:hover { color: var(--text); }
  .shelfpick-card { background: radial-gradient(circle at 76% 82%, rgba(242,142,83,.22), transparent 40%), linear-gradient(155deg, #191b27, #12151f 65%); }
  .game-visual { position: absolute; inset: 55% 0 0; perspective: 900px; }
  .card-stack { position: absolute; z-index: 0; width: 26%; height: 42%; right: 7%; top: 4%; transform: rotate(14deg); }
  .card-stack span { position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.2); border-radius: 9px; background: linear-gradient(145deg, #986152, #543f46); box-shadow: 0 10px 22px rgba(0,0,0,.22); }
  .card-stack span:nth-child(2) { transform: translate(-8px, 7px) rotate(-5deg); background: linear-gradient(145deg, #c19a6a, #75634f); }
  .card-stack span:nth-child(3) { transform: translate(-16px, 14px) rotate(-10deg); background: linear-gradient(145deg, #687b76, #3c4d4d); }
  .game-board { position: absolute; z-index: 1; left: 10%; top: 6%; width: 76%; height: 79%; border: 1px solid rgba(255,255,255,.17); border-radius: 20px; background-color: #252a38; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px), radial-gradient(circle at 70% 24%, rgba(255,122,95,.16), transparent 24%); background-size: 52px 52px, 52px 52px, auto; transform: rotateX(54deg) rotateZ(-7deg); box-shadow: -24px 42px 55px rgba(0,0,0,.46), inset 0 0 55px rgba(0,0,0,.19); }
  .board-path { position: absolute; inset: 11%; border: 2px dashed rgba(244,239,231,.16); border-radius: 38% 56% 45% 54%; transform: rotate(-8deg); }
  .tile { position: absolute; width: 18%; aspect-ratio: 1; border: 1px solid rgba(255,255,255,.16); border-radius: 10px; transform: rotate(12deg); box-shadow: 0 8px 14px rgba(0,0,0,.2); } .t1 { left: 12%; top: 16%; background: #db684f; } .t2 { left: 38%; top: 42%; background: #e2c17d; } .t3 { right: 12%; top: 17%; background: #687b76; }
  .meeple { position: absolute; width: 17px; height: 25px; clip-path: polygon(35% 0,65% 0,78% 24%,100% 38%,81% 54%,75% 100%,25% 100%,19% 54%,0 38%,22% 24%); filter: drop-shadow(3px 5px 3px rgba(0,0,0,.3)); } .m1 { left: 35%; top: 16%; background: #f4efe7; } .m2 { right: 20%; top: 58%; background: #ff7a5f; }
  .token { position: absolute; width: 18px; height: 18px; border: 3px solid rgba(255,255,255,.45); border-radius: 50%; box-shadow: 0 5px 8px rgba(0,0,0,.25); } .token-one { left: 16%; top: 56%; background: #607993; } .token-two { right: 33%; top: 16%; background: #c99b53; }
  .dice { position: absolute; z-index: 3; right: 8%; bottom: 7%; width: 42px; height: 42px; border-radius: 8px; background: #f1ece5; box-shadow: 4px 9px 14px rgba(0,0,0,.3); transform: rotate(12deg); }
  .dice i { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #34313a; } .dice i:nth-child(1) { left: 9px; top: 9px; } .dice i:nth-child(2) { right: 9px; top: 9px; } .dice i:nth-child(3) { left: 18px; top: 18px; } .dice i:nth-child(4) { left: 9px; bottom: 9px; } .dice i:nth-child(5) { right: 9px; bottom: 9px; }
  .pick-panel { position: absolute; left: 13%; bottom: 9%; display: grid; gap: 2px; width: 54%; padding: 12px 15px; border-radius: 10px; color: #1c1b22; background: rgba(247,242,235,.92); box-shadow: 0 12px 30px rgba(0,0,0,.25); }
  .pick-panel small { font-size: .42rem; font-weight: 900; letter-spacing: .12em; color: #8c5e51; } .pick-panel strong { font-size: .76rem; } .pick-panel span { font-size: .5rem; color: #68646a; }
  .usage-card { background: radial-gradient(circle at 70% 76%, rgba(86,95,162,.27), transparent 43%), linear-gradient(155deg, #151a2b, #0f1422 68%); }
  .usage-visual { position: absolute; inset: 53% 0 0; display: grid; place-items: start center; }
  .usage-window { width: 70%; min-width: 320px; border: 1px solid rgba(255,255,255,.17); border-radius: 17px; overflow: hidden; background: rgba(24,28,44,.94); box-shadow: 0 35px 70px rgba(0,0,0,.48), 18px 22px 45px rgba(51,61,111,.12); transform: rotate(2deg); }
  .window-head { display: flex; justify-content: space-between; align-items: center; padding: 13px 16px; color: #d6d7de; background: rgba(255,255,255,.045); border-bottom: 1px solid rgba(255,255,255,.08); font-size: .68rem; font-weight: 700; }
  .window-head i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .usage-body { padding: 20px; }
  .usage-summary { display: flex; justify-content: space-between; align-items: end; } .usage-summary small { color: #858a9c; font-size: .5rem; letter-spacing: .14em; } .usage-summary strong { font-size: 1.5rem; }
  .bar, .usage-row div { overflow: hidden; background: rgba(255,255,255,.08); border-radius: 999px; } .bar { height: 7px; margin: 11px 0 24px; } .bar i, .usage-row div i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), #f4aa7d); border-radius: inherit; }
  .usage-row { display: grid; grid-template-columns: 48px 1fr 32px; gap: 10px; align-items: center; margin: 12px 0; color: #a8abb9; font-size: .58rem; } .usage-row div { height: 4px; } .usage-row b { text-align: right; color: #d9dae0; font-weight: 600; }

  .night-card { background: radial-gradient(circle at 55% 75%, rgba(197,136,72,.19), transparent 50%), linear-gradient(155deg, #1b2026, #111621 68%); }
  .night-visual { position: absolute; inset: 54% 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; padding: 10px 18px 20px; }
  .night-visual img { display: block; width: 100%; max-height: calc(100% - 27px); border: 1px solid rgba(255,255,255,.15); border-radius: 13px; object-fit: contain; background: #0d1015; box-shadow: 0 22px 40px rgba(0,0,0,.35); }
  .night-visual span { color: #979da3; font: 600 .66rem ui-monospace, monospace; letter-spacing: .04em; }

  .section-more-link { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; margin-top: 26px; border-bottom: 1px solid rgba(255,122,95,.5); color: var(--accent-soft); font-size: .9rem; font-weight: 750; }
  .section-more-link:hover { color: var(--text); }
