---
import { site } from '../config';
---

<section class="newsletter" id="about" aria-labelledby="newsletter-title">
  <div class="shell newsletter-panel">
    <div class="newsletter-intro">
      <p class="newsletter-kicker" aria-hidden="true">// INCOMING TRANSMISSION</p>
      <h2 id="newsletter-title">Join the experiment.</h2>
      <p>Updates about Pluto software, strange games and new launches.</p>
      <p>Get early playtest invitations and behind-the-scenes news from Pluto Night Labs.</p>
      <span>One useful transmission at a time. No spam.</span>
    </div>
    <div class="newsletter-action">
      <a class="button button-primary hosted-link" href={site.newsletterUrl} target="_blank" rel="noopener noreferrer">
        Join the Pluto newsletter <span aria-hidden="true">↗</span>
      </a>
      <p class="newsletter-privacy">
        Opens MailerLite’s hosted form in a new tab. Read our <a href="/privacy/">privacy information</a> before subscribing.
      </p>
    </div>
  </div>
</section>

<style>
  .newsletter { padding: 12px 0 28px; }
  .newsletter-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
    align-items: center;
    gap: clamp(34px, 6vw, 78px);
    padding: clamp(22px, 3vw, 34px);
    overflow: hidden;
    border: 1px solid rgba(126, 224, 144, .28);
    border-radius: 6px;
    background:
      linear-gradient(rgba(118, 222, 137, .025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(118, 222, 137, .025) 1px, transparent 1px),
      radial-gradient(circle at 92% 12%, rgba(103, 215, 124, .09), transparent 34%),
      #0a1112;
    background-size: 22px 22px, 22px 22px, auto, auto;
    box-shadow: 5px 5px 0 rgba(72, 121, 79, .16);
  }
  .newsletter-panel::before {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(255, 255, 255, .05);
    content: '';
    pointer-events: none;
  }
  .newsletter-intro, .newsletter-action { position: relative; z-index: 1; min-width: 0; }
  .newsletter-intro { max-width: 470px; padding-left: clamp(2px, 1vw, 14px); }
  .newsletter-intro h2 {
    max-width: 430px;
    margin: 0 0 20px;
    color: #f3eee6;
    font: 750 clamp(2.25rem, 4.6vw, 4.5rem)/.96 Georgia, "Iowan Old Style", serif;
    letter-spacing: -.045em;
  }
  .newsletter-intro > p:not(.newsletter-kicker) {
    max-width: 430px;
    margin: 0 0 12px;
    color: #c2c8c4;
    font-size: .92rem;
    line-height: 1.65;
  }
  .newsletter-intro > span {
    display: block;
    margin-top: 22px;
    color: #d7c6ba;
    font: 700 .67rem/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .065em;
    text-transform: uppercase;
  }
  .newsletter-kicker, .newsletter-privacy {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .newsletter-kicker {
    margin: 0 0 15px;
    color: #ffad86;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .12em;
  }
  .hosted-link { min-width: 220px; text-align: center; }
  .hosted-link span { margin-left: .7rem; }
  .newsletter-privacy {
    margin: 13px 0 0;
    color: #aab3ad;
    font-size: .72rem;
    line-height: 1.6;
    letter-spacing: .035em;
  }
  .newsletter-privacy a { color: #ccefd2; text-decoration: underline; text-underline-offset: 3px; }
  .newsletter-privacy a:hover { color: #fff; }
  @media (max-width: 720px) {
    .newsletter { padding: 8px 0 22px; }
    .newsletter-panel { grid-template-columns: 1fr; gap: 24px; padding: 22px 20px; }
    .newsletter-intro { max-width: none; padding: 0 2px; }
    .newsletter-intro h2 { margin-bottom: 16px; font-size: clamp(2.35rem, 12vw, 3.4rem); }
  }
  @media (max-width: 360px) { .newsletter-panel { padding-inline: 16px; } }
</style>
