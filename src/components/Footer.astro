---
import OrbitMark from './OrbitMark.astro';
import { site, socialLabels } from '../config';
const socialEntries = Object.entries(site.socials) as Array<[keyof typeof site.socials, string]>;
const configuredSocials = socialEntries.filter(([, url]) => Boolean(url));
---
<footer class="night-footer" id="about">
  <div class="shell footer-top">
    <div class="footer-studio">
      <a href="/#home" class="footer-brand"><OrbitMark size={34} /><strong>PLUTO NIGHT LABS</strong></a>
      <p>Independent games &amp; software studio.<br />Cambridgeshire, UK.</p>
    </div>
    <div class="footer-reach">
      <a href={`mailto:${site.supportEmail}`}>{site.supportEmail} ↗</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© 2026 Pluto Night Labs Ltd · Registered in England &amp; Wales</span>
    <nav aria-label="Footer navigation">
      <a href="/products/">Products</a>
      <a href="/lab/">The Lab</a>
      {site.newsletterUrl.startsWith('https://') && <a href={site.newsletterUrl} rel="noopener noreferrer" target="_blank">Email updates</a>}
      <a href="/privacy/">Privacy</a>
      <a href="/contact/">Contact</a>
      {configuredSocials.map(([network,url]) => <a href={url} rel="me noopener" target="_blank">{socialLabels[network]}</a>)}
    </nav>
  </div>
</footer>
<style>
  .night-footer {
    margin-top:15px; padding:32px 0 24px; border-top:1px solid rgba(255,255,255,.17);
    background:radial-gradient(circle at 20% 100%,rgba(183,114,66,.08),transparent 40%),#080d10;
  }
  .footer-top {
    display:flex; justify-content:space-between; align-items:flex-start;
    gap:2rem; padding:1.4rem 0 1.9rem;
  }
  .footer-brand { display:inline-flex; align-items:center; gap:12px; letter-spacing:.12em; font-size:.81rem; font-weight:800; }
  .footer-brand strong { font-weight:800; }
  .footer-studio p,.footer-reach p {
    margin:.75rem 0 0; color:#c1c5c3; font-size:.84rem; line-height:1.65;
  }
  .footer-reach { text-align:right; }
  .footer-reach a { display:inline-block; min-height:35px; color:#f4e6dd; font-size:.91rem; font-weight:700; overflow-wrap:anywhere; }
  .footer-reach a:hover,.footer-bottom a:hover { color:#ffb48b; }
  .footer-bottom {
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.3rem;
    border-top:1px solid rgba(255,255,255,.13); padding-top:1.4rem;
    color:#b1b6b5; font-size:.78rem; line-height:1.6;
  }
  .footer-bottom nav { display:flex; flex-wrap:wrap; gap:.6rem 1.25rem; }
  .footer-bottom nav a { min-height:35px; display:inline-flex; align-items:center; color:#d1d5d1; }
  @media(max-width:650px) {
    .footer-top { flex-direction:column; gap:1.4rem; }
    .footer-reach { text-align:left; }
    .footer-bottom { align-items:flex-start; }
  }
</style>
