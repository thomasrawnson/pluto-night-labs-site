---
interface Props {
  size?: number;
}

const { size = 38 } = Astro.props;
---

<svg
  class="orbit-mark"
  width={size}
  height={size}
  viewBox="0 0 96 96"
  aria-hidden="true"
>
  <defs>
    <radialGradient id="pnl-planet-light" cx="31%" cy="24%" r="79%">
      <stop offset="0" stop-color="#fffdfa" />
      <stop offset=".42" stop-color="#eeeae5" />
      <stop offset=".72" stop-color="#b8bdc3" />
      <stop offset="1" stop-color="#67717d" />
    </radialGradient>
    <linearGradient id="pnl-planet-shade" x1="28%" y1="20%" x2="76%" y2="86%">
      <stop offset=".48" stop-color="#263441" stop-opacity="0" />
      <stop offset="1" stop-color="#172432" stop-opacity=".72" />
    </linearGradient>
    <linearGradient id="pnl-ring" x1="10%" y1="80%" x2="90%" y2="20%">
      <stop offset="0" stop-color="#f3f0eb" />
      <stop offset=".55" stop-color="#fffdfa" />
      <stop offset="1" stop-color="#d7d4d0" />
    </linearGradient>
  </defs>

  <!-- The rear half of the orbit sits behind the planet. -->
  <ellipse
    cx="48"
    cy="49"
    rx="38"
    ry="12"
    transform="rotate(-23 48 49)"
    fill="none"
    stroke="url(#pnl-ring)"
    stroke-width="2.2"
  />

  <circle cx="48" cy="46" r="22" fill="url(#pnl-planet-light)" />
  <circle cx="48" cy="46" r="22" fill="url(#pnl-planet-shade)" />
  <path
    d="M12.9 64.1C28.7 70.6 64.1 54.9 83 33.9"
    fill="none"
    stroke="url(#pnl-ring)"
    stroke-width="2.6"
    stroke-linecap="round"
  />

  <circle class="moon" cx="74" cy="18" r="6" />
</svg>

<style>
  .orbit-mark {
    flex: 0 0 auto;
    overflow: visible;
    shape-rendering: geometricPrecision;
  }

  .moon {
    fill: #f2552d;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .28));
  }
</style>
