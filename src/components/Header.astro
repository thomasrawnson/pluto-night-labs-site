---
import OrbitMark from './OrbitMark.astro';

const pathname = Astro.url.pathname;
const section = pathname.startsWith('/software') || pathname.startsWith('/products') || pathname.startsWith('/shelfpick')
  ? 'Software'
  : pathname.startsWith('/games') || pathname.startsWith('/lab') || pathname.startsWith('/microgames') || pathname.startsWith('/playtests')
    ? 'Games'
    : pathname.startsWith('/about') || pathname.startsWith('/team')
      ? 'About'
      : '';
const links = [
  { label: 'Software', href: '/software/' },
  { label: 'Games', href: '/games/' },
  { label: 'About', href: '/about/' },
];
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href="/" aria-label="Pluto Night Labs home">
      <OrbitMark size={36} />
      <span>PLUTO NIGHT LABS</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={section === link.label ? (pathname === link.href ? 'page' : 'location') : undefined}>{link.label}</a>
      ))}
    </nav>
    <details class="mobile-menu">
      <summary><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => (
          <a href={link.href} aria-current={section === link.label ? (pathname === link.href ? 'page' : 'location') : undefined}>{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding: 15px 0; background: rgba(8, 11, 20, .92); border-bottom: 1px solid rgba(255,255,255,.09); backdrop-filter: blur(18px); }
  .nav-shell, .brand, .desktop-nav, .desktop-nav a { display: flex; align-items: center; }
  .nav-shell { position: relative; justify-content: space-between; gap: 18px; }
  .brand { min-height: 44px; gap: 10px; color: var(--text); font-size: .82rem; font-weight: 800; letter-spacing: .15em; white-space: nowrap; }
  .desktop-nav { gap: clamp(18px, 3vw, 38px); }
  .desktop-nav a { min-height: 44px; color: var(--muted); font-size: .88rem; font-weight: 600; transition: color .2s ease; }
  .desktop-nav a:hover, .desktop-nav a[aria-current] { color: var(--text); }
  .desktop-nav a[aria-current] { box-shadow: inset 0 -2px var(--accent); }
  .mobile-menu { display: none; }
  @media (max-width: 650px) {
    .site-header { padding: 10px 0; }
    .brand { gap: 8px; font-size: .68rem; letter-spacing: .09em; }
    .brand :global(svg) { width: 32px; height: 32px; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: flex; align-items: center; justify-content: center; gap: 9px; min-width: 76px; min-height: 44px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: 7px; color: var(--text); font-size: .83rem; font-weight: 700; cursor: pointer; list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary::marker { content: ''; }
    .mobile-menu summary:hover, .mobile-menu[open] summary { border-color: var(--accent); }
    .menu-icon { width: 15px; height: 11px; border-top: 2px solid currentColor; border-bottom: 2px solid currentColor; }
    .mobile-menu:not([open]) nav { display: none; }
    .mobile-menu nav { position: absolute; top: calc(100% + 10px); right: 0; display: grid; width: min(240px, calc(100vw - 28px)); padding: 8px; border: 1px solid var(--line-strong); border-radius: 10px; background: #111625; box-shadow: 0 18px 38px rgba(0,0,0,.45); }
    .mobile-menu nav a { display: flex; align-items: center; min-height: 48px; padding: 0 14px; border-radius: 6px; color: var(--muted); font-weight: 650; }
    .mobile-menu nav a:hover, .mobile-menu nav a[aria-current] { color: var(--text); background: rgba(255,155,127,.12); }
    .mobile-menu nav a[aria-current] { box-shadow: inset 3px 0 var(--accent); }
  }
  @media (max-width: 350px) { .brand { font-size: .63rem; letter-spacing: .06em; } }
</style>
